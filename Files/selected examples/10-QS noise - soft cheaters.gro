	, timer := "_t_every_step"
	, pop_fields := { "stat_trnd", "stat_tinh"}
	, mode := "population"
	, path := "C:/swLIA/pruebas/newGro3/qsnoise" 
	, folder := "gro_output"
	, file_name := "threshold"
	, format := ".csv" //".csv", ".tsv"
	, precision := 8
]);
*/

timer([ name := "t_snap", start := 100.0, stop := 1350.0, period := 0.2 ]);
snapshot([ name := "img_qs"
	, timer := "t_snap"
	, path := "C:/swLIA/pruebas/newGro3/qsnoise" 
	, folder := "gro_snapshots"
	, file_name := "qs"
	, format := ".png" //".png", ".jpg", ".bmp", ".tif", ".tiff"
]);

