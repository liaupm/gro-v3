include gro3

//params
t_activation_x := 20.0;
t_degradation_x := 20.0;
t_absorb_x := 1.0;

t_activation_y := 20.0;
t_degradation_y := 20.0;
t_absorb_y := 1.0;

t_activation_type1 := 1.0;
t_degradation_type1 := 100.0;

t_activation_r := 5.0;
t_degradation_r := 10.0;

t_activation_gfp := 10.0;
t_degradation_gfp := 20.0;

var_activation := 0.0;
var_degradation := 0.0;

sX_out := 100.0;
sY_out := 100.0;

sX_in_threshold := 2.0;
sY_in_threshold := 2.0;

diff := 1.5;
deg := 0.01;

global_params([ seed := 133087 ]);


//----------------------BIOCIRCUITS---------------------------
molecule([ name := "mol_X", times := {-t_degradation_x, t_activation_x, t_absorb_x }, times_var := { var_degradation, var_activation } ]);
molecule([ name := "mol_Y", times := {-t_degradation_y, t_activation_y, t_absorb_y }, times_var := { var_degradation, var_activation } ]);
molecule([ name := "mol_R", times := {-t_degradation_r, t_activation_r }, times_var := { var_degradation, var_activation } ]);
molecule([ name := "mol_GFP", times := {-t_degradation_gfp, t_activation_gfp }, times_var := { var_degradation, var_activation } ]);


operon([ name := "op_X", output := {"mol_X"} ]);
operon([ name := "op_Y", output := {"mol_Y"} ]);

bgate([ name := "ga_notX", input := {"-mol_X"} ]);
operon([ name := "op_R1", gate := "ga_notX", output := {"mol_R"} ]);

bgate([ name := "ga_notY", type := "NOT", input := {"mol_Y"} ]);
operon([ name := "op_R2", gate := "ga_notY", output := {"mol_R"} ]);

bgate([ name := "ga_notR", type := "NOT", input := {"mol_R"} ]);
operon([ name := "op_GFP", gate := "ga_notR", output := {"mol_GFP"} ]);
		

plasmid([ name := "p_X", operons := { "op_X" } ]);
plasmid([ name := "p_Y", operons := { "op_Y" } ]);
plasmid([ name := "p_2", operons := { "op_R1", "op_R2", "op_GFP" } ]);


cell_type([ name := "cell_X", strain := "_str_slow", plasmids := { "p_X" } ]);
cell_type([ name := "cell_Y", strain := "_str_slow", plasmids := { "p_Y" } ]);
cell_type([ name := "cell_2", strain := "_str_slow", plasmids := { "p_2" } ]);


//intercellular communication
signal([ name := "s_X", kdiff := diff, kdeg := deg, colour := _magenta, colour_sat := 100.0 ]);
signal([ name := "s_Y", kdiff := diff, kdeg := deg, colour := _cyan, colour_sat := 100.0 ]);

bgate([ name := "ga_X_out", input := {"mol_X", "cell_X"} ]);
flux([ name := "flux_X_out", signal := "s_X", gate := "ga_X_out", amount := sX_out ]);

bgate([ name := "ga_Y_out", input := {"mol_Y", "cell_Y"} ]);
flux([ name := "flux_Y_out", signal := "s_Y", gate := "ga_Y_out", amount := sY_out ]);

flux([ name := "flux_X_in", signal := "s_X", gate := "cell_2", output := {"mol_X"}, activation := 2.0, threshold := sX_in_threshold ]);
flux([ name := "flux_Y_in", signal := "s_Y", gate := "cell_2", output := {"mol_Y"}, activation := 2.0, threshold := sY_in_threshold ]);



//------------ WORLD CONTROL -----------------------
//---placers
cell_placer([ name := "cp_X", cell_types := {"cell_X"}, amount := 30.0, coords := [ x := -300.0, y := 0.0, r := 100.0 ] ]);
cell_placer([ name := "cp_Y", cell_types := {"cell_Y"}, amount := 30.0, coords := [ x := 300.0, y := 0.0, r := 100.0 ] ]);
cell_placer([ name := "cp_2", cell_types := {"cell_2"}, amount := 100.0, coords := [ x := 0.0, y := 0.0, r := 100.0 ] ]);
			


//------------ VISUALS -----------------------
cell_colour([ name := "ccol_X", gate := "ga_X_out", rgb := _magenta, intensity := 0.7 ]);
cell_colour([ name := "ccol_Y", gate := "ga_Y_out", rgb := _cyan, intensity := 0.7 ]);
cell_colour([ name := "ccol_GFP", gate := "mol_GFP", rgb := _green ]);
