include gro
set_theme(dark_theme);

set ("dt", 0.1);
set ("population_max", 2000000);
set ("signals", 1.0); //0.0: off, 1.0: on
set ("signals_draw", 1.0); //0.0: off, 1.0: on
set ( "gfp_saturation_max", 200.0 );
set ( "rfp_saturation_max", 200.0 );
grid("continuous", "gro_original", 10, 10, 8);


//========================================================= *params* ===========================================
t_activation_gfp := 50.0;
t_degradation_gfp := 20.0;
t_activation_var_gfp := 0.0;
t_degradation_var_gfp := 0.0;

t_activation_rfp := 100.0;
t_degradation_rfp := 20.0;
t_activation_var_rfp := 0.0;
t_degradation_var_rfp := 0.0;


//========================================================= *genetic circuits* ====================================
genes([ name := "opGFP"
		, proteins := {"GFP"}
		, promoter := [ function := "TRUE", transcription_factors := {} ]
		, prot_act_times := [ times := {t_activation_gfp}, variabilities := {t_activation_var_gfp} ]
		, prot_deg_times := [ times := {t_degradation_gfp}, variabilities := {t_degradation_var_gfp} ]
		]);

genes([ name := "opRFP"
		, proteins := {"RFP"}
		, promoter := [function := "TRUE", transcription_factors := {} ]
		, prot_act_times := [ times := {t_activation_rfp}, variabilities := {t_activation_var_rfp} ]
		, prot_deg_times := [ times := {t_degradation_rfp}, variabilities := {t_degradation_var_rfp} ]
		]);


//--------------------------------------------
plasmids_genes ([ pGFP := {"opGFP"}
					, pRFP := {"opRFP"} 
				]);


//--------------------------------------------
action( {"GFP"}, "d_paint", {"1","0","0","0"} );
action( {"-GFP"}, "d_paint", {"-1","0","0","0"} );

action( {"RFP"}, "d_paint", {"0","1","0","0"} );
action( {"-RFP"}, "d_paint", {"0","-1","0","0"} );

action( {"GFP"}, "set_growth_rate", {"0.05"} );
action( {"RFP"}, "set_growth_rate", {"0.0001"} );
//=============================================== *end of genetic circuits* ====================================




program p() := 
{
	selected: {die()};
    skip();
};

program main() :=
{
   c_ecolis( 10,0,0,100, {"pGFP"}, program p() );
   c_ecolis( 10,0,0,100, {"pRFP"}, program p() );
};