include gro

set_theme(dark_theme);
set ("dt", 0.1);
set ("population_max", 2000000);
set ("signals", 1.0); //0.0: off, 1.0: on
set ("signals_draw", 1.0);
set ( "gfp_saturation_max", 200.0 );
grid("continuous", "gro_original", 50, 10, 8);


//========================================================= *params* ===========================================
t_activation_luxI := 20.0;
t_degradation_luxI := 20.0;

t_activation_cheater:= 0.0;
t_degradation_cheater := 1000.0;

var_activation := 0.0;
var_degradation := 0.0;


ai_out_low := "0.01";
ai_out_high := "1.0";
ai_in_threshold := "0.5";

growth_wt := "0.001";
growth_wt_ai := "0.01";
growth_cheater := "0.005";
growth_cheater_ai := "0.05";

diff := 0.0001; //0.1
deg := 0.2;  //0.01


//========================================================= *extracellular signals* ===========================================
sAi := s_signal([kdiff := diff, kdeg := deg]); // autoinductor



//========================================================= *genetic circuits* ====================================
genes([ name := "opLuxI"
		, proteins := {"luxI"}
		, promoter := [ function := "YES", transcription_factors := {"ai"} ]
		, prot_act_times := [ times := {t_activation_luxI}, variabilities := {var_activation} ]
		, prot_deg_times := [ times := {t_degradation_luxI}, variabilities := {var_degradation} ] 
	]);

genes([ name := "opCheater"
		, proteins := {"cheater"}
		, promoter := [ function := "TRUE", transcription_factors := {} ]
		, prot_act_times := [times := { t_activation_cheater}, variabilities := {var_activation} ]
		, prot_deg_times := [times := { t_degradation_cheater}, variabilities := {var_degradation} ]
	]);
	
	
//---------------------------------------------------
plasmids_genes ([ pWt := {"opLuxI"}
					, pCheater := { "opCheater" } 
				]);


//---------------------------------------------------
action( {"luxI"},"d_paint",{"0","0","1","0"} );
action( {"-luxI"},"d_paint",{"0","0","-1","0"} );
action( {"cheater"},"paint",{"0","100","0","0"} );

action( {"-luxI", "-cheater"},"s_emit_signal",{tostring(sAi),"0.01", "exact"} );
action( {"luxI"},"s_emit_signal",{tostring(sAi),"1.0", "exact"} );
action( {},"s_get_QS",{tostring(sAi),">","0.5","ai"} );

action( {"-cheater", "-ai"},"set_growth_rate",{growth_wt} );
action( {"cheater", "-ai"},"set_growth_rate",{growth_cheater} );
action( {"-cheater", "ai"},"set_growth_rate",{growth_wt_ai} );
action( {"cheater", "ai"},"set_growth_rate",{growth_cheater_ai} );

//=============================================== *end of genetic circuits* ====================================


program p() := 
{
	selected: {die()};
    skip();
};

program main() :=
{
   c_ecolis( 200,0,0,50, {"pWt"}, program p() );
   c_ecolis( 10,0,0,50, {"pCheater"}, program p() );
};