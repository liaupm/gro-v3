	t >= 0.1 :
	{
		snapshot ( route1 <> tostring(n) <> ".tif"  );
		n := n + 1; 
		t := 0.0;
	}*/
	
	
	//save population state program
	/*
	t > 10.0*i & t <= 10.1*i :
	{
		dump_multiple(fp2,{"m0"});
		i := i + 1;
	}
