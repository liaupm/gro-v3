include gro

set_theme(dark_theme);
set ("dt", 0.1);
set ("population_max", 2000000);
set ("signals", 1.0); //0.0: off, 1.0: on
set ("signals_draw", 1.0);
grid("continuous", "gro_original", 10, 10, 8);


//========================================================= *params* ===========================================
t_activation_activator := 10.0;
t_degradation_activator := 0.1;

t_activation_gfp := 20.0;
t_degradation_gfp := 0.1;

var_activation := 0.0;
var_degradation := 0.0;

growth_rate := "0.005";

s0_in_threshold := 0.1;
s0_in_absorb := 0.0;
s0_in_noise := 0.0;


diff := 0.8;
deg := 0.01;

signal_x := 0.0;
signal_y := 0.0;

absorb_threshold := "10.1";

//========================================================= *extracellular signals* ===========================================
s0 := s_signal([ kdiff := diff, kdeg := deg ]);



//========================================================= *genetic circuits* ====================================
genes([ name := "opActivator"
		, proteins := {"activator"}
		, promoter := [ function := "TRUE", transcription_factors := {} ]
		, prot_act_times := [ times := {t_activation_activator}, variabilities := {var_activation} ]
		, prot_deg_times := [ times := {t_degradation_activator}, variabilities := {var_degradation} ]
	]);


genes([ name := "opGFP"
		, proteins := {"GFP"}
		, promoter := [ function := "AND", transcription_factors := {"activator", "s0"} ]
		, prot_act_times := [ times := {t_activation_gfp}, variabilities := {var_activation} ]
		, prot_deg_times := [ times := {t_degradation_gfp}, variabilities := {var_degradation} ]
	]);
		
		
		
//-----------------------------------------

plasmids_genes ([ pActivator := {"opActivator"}
					, pGFP := {"opGFP"}
				]);
					
		
//-----------------------------------------
action( {}, "s_get_QS", {tostring(s0),">",absorb_threshold,"s0"} );
action( {"GFP"}, "d_paint", {"1","0","0","0"} );
action( {"-GFP"}, "d_paint", {"-1","0","0","0"} );
action( {}, "set_growth_rate", {growth_rate} );


//=============================================== *end of genetic circuits* ====================================
program p() := 
{
	selected: {die()};
    skip();
};

program main() :=
{
	true: { s_set_signal( 0, 500.0, signal_x, signal_y ); }
	
	c_ecolis( 100,0,-300,100, {"pGFP"}, program p( ));
	c_ecolis( 100,0,300,100, {"pGFP", "pActivator"}, program p() );
};